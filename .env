# URL da API que o app consome. EXPO_PUBLIC_ entra no bundle: nada secreto aqui.
# Para usar a API local no celular, crie um .env.local com o IP da sua máquina na rede
# (localhost no celular é o próprio aparelho), ex.: EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
EXPO_PUBLIC_API_URL=https://navalha-api-3ge1.onrender.com
# barbearia deste app (o login e o cadastro da API pedem o slug)
EXPO_PUBLIC_BARBEARIA_SLUG=barbearia-navalha